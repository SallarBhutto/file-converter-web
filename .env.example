# Public site origin used for canonical URLs, Open Graph URLs, robots.txt and sitemap.xml.
# Resolution order: NEXT_PUBLIC_SITE_URL, then VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL
# on Vercel, then http://localhost:3000 for local development.
#
# Production (filehush.org) must set:
#   NEXT_PUBLIC_SITE_URL=https://filehush.org
#
# It takes precedence over Vercel-generated domains. Leave it empty for local
# development. Not a secret.
NEXT_PUBLIC_SITE_URL=
